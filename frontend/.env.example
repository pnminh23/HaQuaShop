# ============================================================
# HaQua FRONTEND – biến môi trường mẫu.
#   cd frontend && cp .env.example .env
# Angular không đọc .env lúc chạy; script scripts/set-env.mjs đọc file này
# rồi sinh src/environments/environment.ts mỗi lần `npm start` / `npm run build`.
# KHÔNG commit .env.
# ============================================================

# Địa chỉ API (có /api). Mặc định đường dẫn tương đối, dev server proxy sang backend (proxy.conf.mjs)
API_URL=/api

# Gốc backend để ghép đường dẫn ảnh tải lên (/uploads/...)
ASSETS_URL=
