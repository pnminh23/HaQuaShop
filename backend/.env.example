# ============================================================
# HaQua BACKEND – biến môi trường mẫu.
#   cd backend && cp .env.example .env
# Chạy từ thư mục backend, Spring Boot tự nạp file .env (không cần source).
# KHÔNG commit .env (đã có trong .gitignore).
# Lưu ý: profile phải đặt bằng biến môi trường của shell, không đặt trong .env:
#   SPRING_PROFILES_ACTIVE=prod ./mvnw spring-boot:run
# ============================================================

# ---------- Server ----------
SERVER_PORT=8080

# ---------- MySQL (profile prod) ----------
DB_URL=jdbc:mysql://localhost:3306/haqua?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USER=haqua
DB_PASSWORD=change-me-db-password

# Dùng cho docker-compose.yml (tạo database MySQL)
MYSQL_DATABASE=haqua
MYSQL_USER=haqua
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PORT=3306

# ---------- Bảo mật ----------
# Khóa ký JWT (HS256): tối thiểu 32 ký tự, ngẫu nhiên. Tạo bằng: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
HAQUA_JWT_ACCESS_TTL=15m
HAQUA_JWT_REFRESH_TTL=7d

# Origin của frontend được phép gọi API, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:4200

# ---------- Thanh toán ----------
# Khóa HMAC kiểm chữ ký webhook của cổng thanh toán (header X-Signature)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ---------- Chatbot AI (Groq) ----------
# Lấy key tại https://console.groq.com/keys (dạng gsk_...). KHÔNG chia sẻ / commit key.
LLM_API_KEY=gsk_your_groq_api_key_here
# Endpoint chuẩn OpenAI của Groq. Đổi 3 biến này để dùng nhà cung cấp khác:
#   OpenRouter: https://openrouter.ai/api/v1      Ollama local: http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
# Tên model phải đúng ID trong https://console.groq.com/docs/models. Các model Llama đang ghi là gói
# Enterprise (sẽ báo "model_not_found" nếu tài khoản không có quyền); openai/gpt-oss-20b / gpt-oss-120b dùng được.
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=15s
LLM_MAX_TOKENS=1500
# Chỉ cho model suy luận (gpt-oss): low | medium | high. Model khác (Llama, Ollama…) thì để trống.
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.3

# ---------- Cửa hàng ----------
HAQUA_SHOP_FREE_SHIP_THRESHOLD=500000
HAQUA_SHOP_STANDARD_SHIP_FEE=30000
HAQUA_SHOP_EXPRESS_SHIP_FEE=30000
HAQUA_SHOP_LOW_STOCK_THRESHOLD=5
HAQUA_SHOP_QR_EXPIRE_MINUTES=30
HAQUA_SHOP_GREEN_POINT_RATE=100000

# ---------- Khác ----------
HAQUA_UPLOAD_DIR=uploads
# Nạp dữ liệu mẫu + tài khoản demo (chỉ nên true ở dev)
HAQUA_SEED_ENABLED=true
